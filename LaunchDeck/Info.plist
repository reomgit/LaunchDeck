<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Reom Nagasaka</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>LaunchDeck Pad Assignment</string>
			<key>UTTypeIdentifier</key>
			<string>dev.reom.launchdeck.assignment</string>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.reom.launchdeck.profile</string>
			<key>UTTypeDescription</key>
			<string>LaunchDeck Profile</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>launchdeckprofile</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>LaunchDeck Profile</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.reom.launchdeck.profile</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>LaunchDeck runs AppleScript actions you review and enable to control the applications you choose.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Enable optional audio-reactive lighting using microphone loudness. Audio is processed locally and is not saved.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LaunchDeck connects your paired phone or tablet to its virtual control deck over your local network.</string>
</dict>
</plist>
